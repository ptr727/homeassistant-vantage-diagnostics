#!/usr/bin/env bash
# Install dev requirements for this repo:
#   1. Python base + test requirements (requirements.txt, requirements-test.txt).
#   2. The home-assistant-frontend package HA's own manifest pins, pre-installed into .venv.
#   3. The pre-commit hook for the local commit gate, enabled in the base clone only.
#      The hook runner, pre-commit, is a user-level uv tool install.
#   4. The markdownlint-cli2 tool pinned via npm.
#      It is the same engine the VS Code davidanson.vscode-markdownlint extension uses.
#      CLI verification therefore matches what the IDE shows.
#      The devcontainer `node:2` feature provides Node.js itself.
#      The install is global, through npm install -g.
#
# The setup skips actionlint, since the VS Code task runs it in Docker through the hub's docker_lint.py.

set -Eeuo pipefail

usage="Usage: scripts/setup [-h | --help]
Set up the dev environment: the .venv, the dev tools, and the host tools the dev loop needs.
Some installs reach outside the checkout, such as the global npm install.
The header comment of scripts/setup lists what it installs."
if (($# > 0)); then
    if (($# == 1)) && [[ "$1" == -h || "$1" == --help ]]; then
        echo "$usage"
        exit 0
    fi
    echo "Unexpected arguments: $*" >&2
    echo "$usage" >&2
    exit 2
fi

cd "$(dirname "$0")/.."

# The dev toolchain is uv-managed.
# Ensure uv is present, create the .venv, and install the pinned dependencies into it.
# The requirements*.txt files stay the single source of truth.
# CI installs the same files via pip because the HA-version matrix needs pip, so only the local dev environment uses uv.
# In the devcontainer, the ghcr.io/devcontainers-extra/features/uv feature installs uv.
# On a bare host, install it once from https://docs.astral.sh/uv/.
# The script requires uv rather than fetching a remote install script, so there is no curl-to-shell and no pip into the system.
if ! command -v uv >/dev/null 2>&1; then
    echo "uv not found. In the devcontainer it comes from the uv feature; on a" >&2
    echo "host, install it (https://docs.astral.sh/uv/) and re-run scripts/setup." >&2
    exit 1
fi

# Create the venv only when a usable one is not already present.
# The .venv volume mounts an empty directory on first container create, and a rebuilt container may already have a valid venv.
# Recreate it when it is absent or built against a different Python minor.
# The named volume persists across rebuilds, so a venv from an older base image would otherwise be reused silently.
# The --clear flag keeps the step non-interactive, since uv otherwise prompts before replacing a venv and would hang the postCreate run.
if [[ ! -x .venv/bin/python ]] ||
    ! .venv/bin/python -c 'import sys; sys.exit(sys.version_info[:2] != (3, 14))' 2>/dev/null; then
    uv venv --python 3.14 --clear
fi
# shellcheck source=/dev/null
source .venv/bin/activate
uv pip install --requirement requirements.txt
uv pip install --requirement requirements-test.txt

# Pre-install the frontend package HA expects.
# HA otherwise installs it at runtime, which races the frontend component's setup and drops HA into recovery mode on first launch.
# Pin to the version HA's own manifest declares.
frontend_req="$(
    python - <<'PY'
import json, pathlib
try:
    import homeassistant.components.frontend as f
    m = json.loads((pathlib.Path(f.__file__).parent / "manifest.json").read_text())
    print(next((r for r in m.get("requirements", []) if r.startswith("home-assistant-frontend")), ""))
except Exception:
    pass
PY
)"
if [[ -n "${frontend_req}" ]]; then
    echo "Pre-installing ${frontend_req}"
    uv pip install "${frontend_req}"
fi

# --- pre-commit hook --------------------------------------------------------
# The commit gate in .pre-commit-config.yaml runs the tools in the .venv built above.
# The hook runner, pre-commit, is a host tool installed with uv, never a project dependency.
# A linked worktree shares the base clone's hooks directory, so only the base clone enables the hook.
if ! inside_work_tree="$(LC_ALL=C git rev-parse --is-inside-work-tree 2>&1)"; then
    if [[ "${inside_work_tree}" != *"not a git repository"* ]]; then
        echo "${inside_work_tree}" >&2
        exit 1
    fi
    echo "Not a git checkout; skipping the pre-commit hook." >&2
else
    # A commit inside the devcontainer runs the host's hook, which falls back to the pre-commit on PATH.
    if ! command -v pre-commit >/dev/null 2>&1; then
        uv tool install pre-commit
    fi
    if ! [[ "$(git rev-parse --git-dir)" -ef "$(git rev-parse --git-common-dir)" ]]; then
        echo "Linked worktree; the base clone enables the pre-commit hook, skipping."
    elif [[ -n "${REMOTE_CONTAINERS:-}" || -f /.dockerenv || -f /run/.containerenv ]]; then
        echo "Inside a container: install the hook from the host for a bind-mounted checkout, or run pre-commit install here for a clone inside the container."
    elif [[ -n "$(git config --get core.hooksPath || true)" ]]; then
        echo "core.hooksPath is set, so pre-commit cannot install its hook; skipping." >&2
    else
        pre_commit="$(command -v pre-commit || echo "$(uv tool dir --bin)/pre-commit")"
        "${pre_commit}" install
    fi
fi

# --- markdownlint-cli2 ----------------------------------------------------
# The binary is pinned and npm-installed, so CLI runs match the davidanson.vscode-markdownlint extension's output.
# Node.js is supplied by the `ghcr.io/devcontainers/features/node:2` devcontainer feature.
# When it is missing, as when running scripts/setup outside the devcontainer, the script skips this local install.
# CI also lints markdown in the hub validate task's Lint sources job, so this only mirrors the IDE extension locally.
MARKDOWNLINT_VERSION=0.22.1

if command -v npm >/dev/null 2>&1; then
    installed_markdownlint=""
    if command -v markdownlint-cli2 >/dev/null 2>&1; then
        installed_markdownlint="$(markdownlint-cli2 --version 2>/dev/null |
            awk '{print $2}' | tr -d 'v')"
    fi
    if [[ "${installed_markdownlint}" = "${MARKDOWNLINT_VERSION}" ]]; then
        echo "markdownlint-cli2 ${MARKDOWNLINT_VERSION} already installed, skipping."
    else
        echo "Installing markdownlint-cli2@${MARKDOWNLINT_VERSION} via npm"
        npm install -g "markdownlint-cli2@${MARKDOWNLINT_VERSION}"
        # Avoid piping to `head` here; Node 24 can raise EPIPE on closed stdout.
        installed_markdownlint="$(markdownlint-cli2 --version 2>/dev/null)"
        installed_markdownlint="${installed_markdownlint%%$'\n'*}"
        echo "Installed: ${installed_markdownlint}"
    fi
else
    echo "npm not available; skipping markdownlint-cli2 install. It is a CI-gated check - run it via its Docker image or in the devcontainer." >&2
fi
